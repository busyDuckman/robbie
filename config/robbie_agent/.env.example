# Environment for Layer A (the LLM). just setup creates .env (not committed) from this file.

# Folder holding downloaded model weights. Relative paths are from the repo root.
# Point this at a shared folder to avoid re-downloading models across projects.
MODELS_DIR=.models

# LLM weights (GGUF) and its vision projector (mmproj), relative to MODELS_DIR.
# Set by just setup from the options in scripts/setup/llm_models.yaml.
LLM_MODEL=
LLM_MMPROJ=

# Locale for RELM AS expansion (e.g. reading dates and money), used when no --locale is given.
LOCALE=en_GB
