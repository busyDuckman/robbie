{
  "_about": "Tables that must load (ok: true) or fail with bad_table. names lists the macros, in table order. file is relative to the repo root.",
  "cases": [
    {"name": "example table loads", "file": "common/robbie-lib-test/relm/example_table.yaml", "ok": true},
    {"name": "robbie's table loads", "file": "config/relm_table.yaml", "ok": true},
    {"name": "empty table", "yaml": "", "ok": true, "names": []},
    {"name": "order is kept", "yaml": "b: <PAUSE duration=\"1\"/>\na: <PAUSE duration=\"2\"/>\n/b: <MESSAGE sub=\"x\" action=\"y\"/>\n", "ok": true, "names": ["b", "a"]},
    {"name": "not a mapping", "yaml": "- a\n- b\n", "ok": false},
    {"name": "not yaml", "yaml": "a: [\n", "ok": false},
    {"name": "value is not a string", "yaml": "a: 3\n", "ok": false},
    {"name": "duplicate name", "yaml": "a: <PAUSE duration=\"1\"/>\na: <PAUSE duration=\"2\"/>\n", "ok": false},
    {"name": "bad macro name", "yaml": "\"9lives\": <PAUSE duration=\"1\"/>\n", "ok": false},
    {"name": "close without open", "yaml": "/a: <MESSAGE sub=\"x\" action=\"y\"/>\n", "ok": false},
    {"name": "close holding a span", "yaml": "a: <MESSAGE sub=\"x\" action=\"y\"/>\n/a: <VAD v=\"3\">\n", "ok": false},
    {"name": "unknown command", "yaml": "a: <SMILE/>\n", "ok": false},
    {"name": "text in an entry", "yaml": "a: hello <PAUSE duration=\"1\"/>\n", "ok": false},
    {"name": "empty entry", "yaml": "a: \"\"\n", "ok": false},
    {"name": "closing tag in an entry", "yaml": "a: <VAD v=\"3\"></VAD>\n", "ok": false},
    {"name": "malformed tag", "yaml": "a: <VAD v=3>\n", "ok": false},
    {"name": "span written self-closing", "yaml": "a: <VAD v=\"3\"/>\n", "ok": false},
    {"name": "single written as open tag", "yaml": "a: <PAUSE duration=\"1\">\n", "ok": false},
    {"name": "same span twice", "yaml": "a: <VAD v=\"3\"><VAD a=\"3\">\n", "ok": false},
    {"name": "unknown param", "yaml": "a: <VAD x=\"3\">\n", "ok": false},
    {"name": "param given twice via alias", "yaml": "a: <VAD v=\"3\" valence=\"4\">\n", "ok": false},
    {"name": "VAD out of range", "yaml": "a: <VAD v=\"6\">\n", "ok": false},
    {"name": "VAD not a number", "yaml": "a: <VAD v=\"high\">\n", "ok": false},
    {"name": "VAD none is fine", "yaml": "a: <VAD v=\"none\" a=\"1\" d=\"5\">\n", "ok": true},
    {"name": "PROSODY zero", "yaml": "a: <PROSODY s=\"0\">\n", "ok": false},
    {"name": "PROSODY exponent", "yaml": "a: <PROSODY s=\"1e0\">\n", "ok": false},
    {"name": "PAUSE needs duration", "yaml": "a: <PAUSE/>\n", "ok": false},
    {"name": "PAUSE negative", "yaml": "a: <PAUSE duration=\"-1\"/>\n", "ok": false},
    {"name": "MESSAGE needs action", "yaml": "a: <MESSAGE sub=\"eyes\"/>\n", "ok": false},
    {"name": "AS needs format", "yaml": "a: <AS locale=\"en_GB\">\n", "ok": false},
    {"name": "AS unknown format", "yaml": "a: <AS format=\"roman\">\n", "ok": false},
    {"name": "AUDIO empty file_name", "yaml": "a: <AUDIO file_name=\"\"/>\n", "ok": false},
    {"name": "VOICE with no params", "yaml": "a: <VOICE>\n", "ok": true},
    {"name": "BEEP good", "yaml": "a: <BEEP melody=\"C4,0.1;C#4,0.1; Eb4 , 0.25 ;R,0.125;B8,1;\"/>\n", "ok": true},
    {"name": "BEEP empty", "yaml": "a: <BEEP melody=\" ; \"/>\n", "ok": false},
    {"name": "BEEP bad note", "yaml": "a: <BEEP melody=\"H4,0.1\"/>\n", "ok": false},
    {"name": "BEEP bad octave", "yaml": "a: <BEEP melody=\"C9,0.1\"/>\n", "ok": false},
    {"name": "BEEP lower case note", "yaml": "a: <BEEP melody=\"c4,0.1\"/>\n", "ok": false},
    {"name": "BEEP zero duration", "yaml": "a: <BEEP melody=\"C4,0\"/>\n", "ok": false},
    {"name": "BEEP missing duration", "yaml": "a: <BEEP melody=\"C4\"/>\n", "ok": false}
  ]
}
